          },
          {
            "name": "OrderProblemSchema",
            "content": "{\"type\":\"object\",\"required\":[\"code\",\"sku\"],\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"}}}"
          }
        ]
      },
      "formats": {
        "format": [
          {
            "name": "OrderIn",
            "mediaType": "application/json",
            "schemaRef": "OrderInSchema"
          },
          {
            "name": "OrderOut",
            "mediaType": "application/json",
            "schemaRef": "OrderOutSchema"
          },
          {
            "name": "OrderProblem",
            "mediaType": "application/json",
            "schemaRef": "OrderProblemSchema"
          },
          {
            "name": "AuditNote",
