{
	"dil": {
		"integrations": {
			"integration": {
				"flows": {
					"flow": {
						"id": "timer",
						"name": "timer",
						"type": "esb",
						"steps": {
							"step": [
								{
									"id": "timer-source",
									"type": "source",
									"uri": "timer:tick",
									"options": {
										"period": 1000
									},
									"links": {
										"link": {
											"id": "timer-action",
											"bound": "out",
											"transport": "sync"
										}
									}
								},
								{
									"id": "timer-action",
									"type": "action",
									"uri": "passthrough",
									"links": {
										"link": [
											{
												"id": "timer-action",
												"bound": "in",
												"transport": "sync"
											},
											{
												"id": "timer-sink",
												"bound": "out",
												"transport": "sync"
											}
										]
									}
								},
								{
									"id": "timer-sink",
									"type": "sink",
									"uri": "passthrough",
									"links": {
										"link": {
											"id": "timer-sink",
											"bound": "in",
											"transport": "sync"
										}
									}
								},
								{
									"id": "timer-error",
									"type": "error",
									"uri": "failedexchange"
								}
							]
						}
					}
				}
			}
		}
	}
}
