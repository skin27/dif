									"options": {
										"language": "constant",
										"expression": "<html>\n   <div>\n      <span class=\"rubriek\"\n            style=\"font-family: Open sans; font-size: 16px; font-weight: bold; letter-spacing: 0.4px; line-height: 0px; color: #354684;\">Arbeidsrecht / Sociaal recht</span>\n      <span><BR><BR></span>\n      <table style=\"height: 80px;\" width=\"550px\">\n         <tbody>\n            <tr>\n               <td style=\"55px\">\n                  <img src=\"https://lms1.bibis.nl/praktizijn/covers/0000/Praktizijnslogo.jpg\"\n                       alt=\"\"\n                       width=\"50px\"\n                       height=\"80px\"/>\n               </td>\n               <td style=\"495px\">\n                  <span class=\"titel\"\n                        style=\"font-family: Open sans; font-size: 13px; font-weight: bold;\"> Just transition  naar een klimaatneutrale economie | :  de mogelijkheden en beperkingen voor de Nederlandse sociale dialoog</span>\n                  <span class=\"auteurs\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"> / Dijk, S. van [Saar]</span>\n                  <span><BR></span>\n                  <span class=\"isbn\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\">Tijdschrift Recht en Arbeid TRA 2025, afl. 2,                                                             </span>\n                  <span><BR></span>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79215\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Vraag aan | </a>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79215\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Informatie</a>\n               </td>\n            </tr>\n            <tr>\n               <td style=\"width: 55px;\">&nbsp;</td>\n               <td style=\"width: 495px;\">&nbsp;</td>\n            </tr>\n         </tbody>\n         <tbody>\n            <tr>\n               <td style=\"55px\">\n                  <img src=\"https://lms1.bibis.nl/praktizijn/covers/0000/Praktizijnslogo.jpg\"\n                       alt=\"\"\n                       width=\"50px\"\n                       height=\"80px\"/>\n               </td>\n               <td style=\"495px\">\n                  <span class=\"titel\"\n                        style=\"font-family: Open sans; font-size: 13px; font-weight: bold;\">Arbeidsrecht over de datum | : over de houdbaarheid van ons arbeidsbestel nu en in de nabije toekomst</span>\n                  <span class=\"auteurs\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"> / Houweling, A.R. [Ruben]</span>\n                  <span><BR></span>\n                  <span class=\"isbn\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\">Tijdschrift Arbeidsrecht Praktijk TAP 2025, afl. 1,                                                             </span>\n                  <span><BR></span>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79242\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Vraag aan | </a>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79242\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Informatie</a>\n               </td>\n            </tr>\n            <tr>\n               <td style=\"width: 55px;\">&nbsp;</td>\n               <td style=\"width: 495px;\">&nbsp;</td>\n            </tr>\n         </tbody>\n         <tbody>\n            <tr>\n               <td style=\"55px\">\n                  <img src=\"https://lms1.bibis.nl/praktizijn/covers/0000/Praktizijnslogo.jpg\"\n                       alt=\"\"\n                       width=\"50px\"\n                       height=\"80px\"/>\n               </td>\n               <td style=\"495px\">\n                  <span class=\"titel\"\n                        style=\"font-family: Open sans; font-size: 13px; font-weight: bold;\">De civiele rechter in tijden van crisis: adaptiviteit en rechtszekerheid in het handelsverkeer</span>\n                  <span class=\"auteurs\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"> / Bauw, E. [Eddy] | Baaij, C.J.W. [Jaap]</span>\n                  <span><BR></span>\n                  <span class=\"isbn\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\">Rechtsgeleerd Magazijn Themis RMT 2025, afl.1,                                                             </span>\n                  <span><BR></span>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/13/79331\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Vraag aan | </a>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/13/79331\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Informatie</a>\n               </td>\n            </tr>\n            <tr>\n               <td style=\"width: 55px;\">&nbsp;</td>\n               <td style=\"width: 495px;\">&nbsp;</td>\n            </tr>\n         </tbody>\n         <tbody>\n            <tr>\n               <td style=\"55px\">\n                  <img src=\"https://lms1.bibis.nl/praktizijn/covers/0000/Praktizijnslogo.jpg\"\n                       alt=\"\"\n                       width=\"50px\"\n                       height=\"80px\"/>\n               </td>\n               <td style=\"495px\">\n                  <span class=\"titel\"\n                        style=\"font-family: Open sans; font-size: 13px; font-weight: bold;\">De rechtspositie van ingeleende werknemers in grensoverschrijdende driehoeksrelaties</span>\n                  <span class=\"auteurs\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"> / Koster, S.R.</span>\n                  <span><BR></span>\n                  <span class=\"isbn\"\n                        style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\">Tijdschrift Recht en Arbeid TRA 2025, afl. 2,                                                             </span>\n                  <span><BR></span>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79216\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Vraag aan | </a>\n                  <a style=\"font-family: Open sans; font-size: 11px; font-weight: 400;\"\n                     href=\"https://bibliotheek.praktizijn.nl/pages/home?configObject=27756328&amp;openDocument=AV/24/79216\"\n                     target=\"_blank\"\n                     rel=\"noopener noreferrer\">Informatie</a>\n               </td>\n            </tr>\n            <tr>\n               <td style=\"width: 55px;\">&nbsp;</td>\n          