          {
            "name": "OrderInSchema",
            "content": "{\"type\":\"object\",\"required\":[\"sku\",\"quantity\"],\"additionalProperties\":false,\"properties\":{\"sku\":{\"type\":\"string\",\"minLength\":1},\"quantity\":{\"type\":\"integer\",\"minimum\":1}}}"
          },
          {
            "name": "OrderOutSchema",
