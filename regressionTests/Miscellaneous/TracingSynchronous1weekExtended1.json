				"resource": {
					"name": "62e88c04-3668-4efa-9cb1-746f40dafe2e",
					"content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<xsl:stylesheet xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\" version=\"1.0\">\n    <xsl:output method=\"xml\" indent=\"yes\"/>\n    \n    <xsl:template match=\"/\">\n        <Enriched>\n            <employees>\n                <employee>\n                    <xsl:apply-templates select=\"/Enriched/employees/employee/element\"/>\n                </employee>\n            </employees>\n        </Enriched>\n    </xsl:template>\n    \n    <xsl:template match=\"element\">\n        <element>\n            <xsl:copy-of select=\"name\"/>\n            <xsl:copy-of select=\"id\"/>\n            <job>\n                <xsl:choose>\n                    <xsl:when test=\"name='John'\">carpenter</xsl:when>\n                    <xsl:when test=\"name='Frank'\">mason</xsl:when>\n                    <xsl:when test=\"name='Max'\">painter</xsl:when>\n                </xsl:choose>\n            </job>\n        </element>\n    </xsl:template>\n    \n</xsl:stylesheet>"
				}
			},
